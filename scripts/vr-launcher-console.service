# vr-launcher-console.service -- lighter tty4-based alternative to the
# gnome-terminal + GNOME autostart approach (no longer used -- see
# vr-launcher-console.sh for the reasoning). NOT installed/enabled by default.
#
# Install (test scripts/vr-launcher-console.sh by hand on a spare VT first). This file is a
# TEMPLATE (@REPO_DIR@ = absolute path of the repo checkout, no trailing slash); from the
# repo root:
#   sed "s|@REPO_DIR@|$PWD|g" scripts/vr-launcher-console.service \
#       | sudo tee /etc/systemd/system/vr-launcher-console.service >/dev/null
#   sudo systemctl daemon-reload
#   sudo systemctl enable vr-launcher-console.service
#
# Uninstall:
#   sudo systemctl disable vr-launcher-console.service
#   sudo rm /etc/systemd/system/vr-launcher-console.service
#   sudo systemctl daemon-reload

[Unit]
Description=VR launcher console (tty4) -- shows the picker after a real LISTO, otherwise a normal console
After=graphical.target getty@tty4.service
Conflicts=getty@tty4.service

[Service]
# System unit (runs as root), rendered from this template at install time: @REPO_DIR@ becomes
# the checkout path. The unprivileged account the picker drops to is NOT set here: the script
# takes it from VR_USER, defaulting to the owner of the checkout (override with an
# Environment=VR_USER=<account> line in this section if the checkout is owned by someone else).
ExecStart=@REPO_DIR@/scripts/vr-launcher-console.sh
Type=idle
Restart=on-failure
RestartSec=5
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty4
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=graphical.target
