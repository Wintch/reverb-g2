# vr-launcher-console.service -- lighter tty4-based alternative to the
# gnome-terminal + GNOME autostart approach (no longer used -- see
# vr-launcher-console.sh for the reasoning). NOT installed/enabled by default.
#
# Install (test scripts/vr-launcher-console.sh by hand on a spare VT first):
#   sudo cp scripts/vr-launcher-console.service /etc/systemd/system/
#   sudo systemctl enable vr-launcher-console.service
#
# Uninstall:
#   sudo systemctl disable vr-launcher-console.service
#   sudo rm /etc/systemd/system/vr-launcher-console.service
#   sudo systemctl daemon-reload

[Unit]
Description=VR launcher console (tty4) -- shows the picker after a real LISTO, otherwise a normal console
After=graphical.target getty@tty4.service
Conflicts=getty@tty4.service

[Service]
ExecStart=/home/iam/Documents/reverb-g2/scripts/vr-launcher-console.sh
Type=idle
Restart=on-failure
RestartSec=5
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty4
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=graphical.target
