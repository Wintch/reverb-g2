+            if (zoomValue.isActive == XR_TRUE) {
+                const float v = zoomValue.currentState;
+                if (!zoomLatched[hand] && std::fabs(v) > 0.7f) {
+                    if (v > 0.0f) {
+                        PlayerControl::ZoomIn();
+                    } else {
+                        PlayerControl::ZoomOut();
+                    }
+                    zoomLatched[hand] = true;
