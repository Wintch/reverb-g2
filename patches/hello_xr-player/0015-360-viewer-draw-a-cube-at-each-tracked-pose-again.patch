From 2f6b3e9d4969ff27cef17e414344f65466d98209 Mon Sep 17 00:00:00 2001
From: brunduk <nikolai.viktorovich@gmail.com>
Date: Tue, 11 Aug 2026 04:52:49 -0300
Subject: [PATCH] 360 viewer: draw a cube at each tracked pose again

Restores the original hello_xr sample's per-pose cubes, which this
player dropped when it replaced the geometry pipeline wholesale with the
fullscreen-triangle 360 path. The cubes vector has been arriving in
RenderView fully populated and being discarded ever since.

Adds a second graphics pipeline with its own vertex/fragment pair, drawn
after the 360 background with depth test. It shares the existing
VkPipelineLayout: the push-constant block is declared identically and
only the leading mvp is read, so no second layout is needed. The cube
geometry and its buffers were already being uploaded -- the skybox uses
the same vertex buffer.

compile_glsl derives the shader stage from the file name and so allows
only one file per stage; the new pair gets explicit rules, the same way
yuv_frag.glsl already does.

This is the in-headset instrument for controller tracking. Until a real
controller position is fused, the controller cubes are expected to sit
still in space while the head moves around them -- Monado pins untracked
devices at a fixed offset from the tracking origin.

Signed-off-by: brunduk <nikolai.viktorovich@gmail.com>
---
 src/tests/hello_xr/CMakeLists.txt             |  27 +++++
 src/tests/hello_xr/graphicsplugin_vulkan.cpp  | 100 +++++++++++++++---
 .../hello_xr/vulkan_shaders/cube_frag.glsl    |  18 ++++
 .../hello_xr/vulkan_shaders/cube_vert.glsl    |  33 ++++++
 4 files changed, 165 insertions(+), 13 deletions(-)
 create mode 100644 src/tests/hello_xr/vulkan_shaders/cube_frag.glsl
 create mode 100644 src/tests/hello_xr/vulkan_shaders/cube_vert.glsl

diff --git a/src/tests/hello_xr/CMakeLists.txt b/src/tests/hello_xr/CMakeLists.txt
index b2a794e..19003e5 100644
--- a/src/tests/hello_xr/CMakeLists.txt
+++ b/src/tests/hello_xr/CMakeLists.txt
@@ -142,6 +142,33 @@ endif()
 add_custom_target(run_hello_xr_yuv_glsl ALL DEPENDS "${YUV_FRAG_SPV}")
 add_dependencies(hello_xr run_hello_xr_yuv_glsl)
 
+# The tracked-pose cube shaders, same story as yuv_frag above: compile_glsl allows only one
+# file per stage, and these are a second vertex/fragment pair.
+foreach(cube_stage vert frag)
+    set(CUBE_SPV "${CMAKE_CURRENT_BINARY_DIR}/cube_${cube_stage}.spv")
+    if(GLSL_COMPILER)
+        add_custom_command(
+            OUTPUT "${CUBE_SPV}"
+            COMMAND "${GLSL_COMPILER}" -mfmt=c -fshader-stage=${cube_stage}
+                    "vulkan_shaders/cube_${cube_stage}.glsl" -o "${CUBE_SPV}"
+            DEPENDS "vulkan_shaders/cube_${cube_stage}.glsl"
+            WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
+            VERBATIM
+        )
+    elseif(GLSLANG_VALIDATOR)
+        add_custom_command(
+            OUTPUT "${CUBE_SPV}"
+            COMMAND "${GLSLANG_VALIDATOR}" -V -S ${cube_stage}
+                    "vulkan_shaders/cube_${cube_stage}.glsl" -x -o "${CUBE_SPV}"
+            DEPENDS "vulkan_shaders/cube_${cube_stage}.glsl"
+            WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
+            VERBATIM
+        )
+    endif()
+    add_custom_target(run_hello_xr_cube_${cube_stage}_glsl ALL DEPENDS "${CUBE_SPV}")
+    add_dependencies(hello_xr run_hello_xr_cube_${cube_stage}_glsl)
+endforeach()
+
 target_include_directories(
     hello_xr
     PRIVATE
diff --git a/src/tests/hello_xr/graphicsplugin_vulkan.cpp b/src/tests/hello_xr/graphicsplugin_vulkan.cpp
index 036f8f2..2d1a6f1 100644
--- a/src/tests/hello_xr/graphicsplugin_vulkan.cpp
