diff --git a/src/tests/hello_xr/vulkan_shaders/cube_vert.glsl b/src/tests/hello_xr/vulkan_shaders/cube_vert.glsl
new file mode 100644
index 0000000..fccdff5
--- /dev/null
+++ b/src/tests/hello_xr/vulkan_shaders/cube_vert.glsl
@@ -0,0 +1,33 @@
+// Copyright (c) 2017-2025 The Khronos Group Inc.
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#version 400
+#extension GL_ARB_separate_shader_objects : enable
+#extension GL_ARB_shading_language_420pack : enable
+
+#pragma vertex
+
+// Same push-constant block the 360 pipeline uses, so both pipelines can share one
+// VkPipelineLayout. Only the leading mvp is read here; the rest is the 360 viewer's
+// business and is declared solely to keep the offsets identical.
+layout (std140, push_constant) uniform buf
+{
+    mat4 mvp;
+} ubuf;
+
+layout (location = 0) in vec3 Position;
+layout (location = 1) in vec3 Color;
+
+layout (location = 0) out vec4 oColor;
+out gl_PerVertex
+{
+    vec4 gl_Position;
+};
+
+void main()
+{
+    oColor.rgb = Color.rgb;
+    oColor.a = 1.0;
+    gl_Position = ubuf.mvp * vec4(Position, 1);
+}
diff --git a/src/tests/hello_xr/vulkan_shaders/vert.glsl b/src/tests/hello_xr/vulkan_shaders/vert.glsl
index 732ec08..1743a6d 100644
--- a/src/tests/hello_xr/vulkan_shaders/vert.glsl
+++ b/src/tests/hello_xr/vulkan_shaders/vert.glsl
@@ -17,5 +17,13 @@ void main()
 {
     vec2 pos[3] = vec2[](vec2(-1.0, -1.0), vec2(3.0, -1.0), vec2(-1.0, 3.0));
     oNdc = pos[gl_VertexIndex];
-    gl_Position = vec4(oNdc, 0.0, 1.0);
+    // Far plane, not near. This triangle is the 360 background: it must sit behind
+    // everything else so that geometry drawn afterwards (the tracked-pose cubes) passes the
+    // LESS depth test. Writing 0.0 here filled the depth buffer with the nearest possible
+    // value and silently discarded every cube.
+    //
+    // Just under 1.0 rather than exactly 1.0: the depth buffer is cleared to 1.0 and the
+    // compare op is LESS, so a depth of exactly 1.0 would fail against the clear value and
+    // this triangle itself would stop drawing.
+    gl_Position = vec4(oNdc, 0.9999, 1.0);
 }
