     return true;
 }
 
 void Video360::SetLoop(bool loop) { m_impl->loop = loop; }
-void Video360::SetRate(double rate) { m_impl->rate = (rate > 0.0) ? rate : 0.0; }
+void Video360::SetRate(double rate) {
+    m_impl->rate = (rate > 0.0) ? rate : 0.0;
