         match origin {
@@ -419,6 +433,40 @@ impl<C: Compositor> OpenXrData<C> {
     /// XR_EXT_user_presence enabled, a doffed headset ignores the trigger; and
     /// reset_tracking_space now refuses an invalid head pose. Must be called with no
     /// session_data guard held: reset_tracking_space takes the write lock.
+    /// 2026-08-30 diagnostics (opt-in: XRIZER_LOG_SERVED_YAW=1): the head yaw the game is being
+    /// served, once a second, in the universe it selected and in both raw reference spaces.
+    /// Called from WaitGetPoses. Found the 3dof yaw swings of docs/80 (2026-08-30 entry).
+    pub fn log_served_yaw(&self) {
+        use std::sync::atomic::{AtomicU32, Ordering};
+        use std::sync::OnceLock;
+        static ENABLED: OnceLock<bool> = OnceLock::new();
+        if !*ENABLED.get_or_init(|| std::env::var_os("XRIZER_LOG_SERVED_YAW").is_some()) {
+            return;
+        }
+        static N: AtomicU32 = AtomicU32::new(0);
+        if N.fetch_add(1, Ordering::Relaxed) % 90 != 0 {
+            return;
+        }
+        let d = self.session_data.get();
+        let t = self.display_time.get();
+        let yaw = |space: &xr::Space| -> String {
+            match d.view_space.locate(space, t) {
+                Ok(l) => {
+                    let q = l.pose.orientation;
+                    format!("{:.1}", Quat::from_xyzw(q.x, q.y, q.z, q.w).to_euler(glam::EulerRot::YXZ).0.to_degrees())
+                }
+                Err(e) => format!("err {e:?}"),
+            }
+        };
+        info!(
+            "served-yaw: universe {:?}: adjusted {} deg | raw STAGE {} LOCAL {} deg",
+            d.current_origin,
+            yaw(d.tracking_space()),
+            yaw(&d.stage_space_reference),
+            yaw(&d.local_space_reference)
+        );
+    }
+
