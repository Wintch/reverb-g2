                     },
                 )
                 .unwrap();
+            // 2026-08-30 diagnostics (3dof booth button: the fire logs but the cockpit stays
+            // turned): what the reset actually did, from the runtime's point of view.
+            if let Ok(after) = view_space.locate(&*adjusted_space, self.display_time.get()) {
