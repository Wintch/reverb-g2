+                let yaw_after = Quat::from_xyzw(q.x, q.y, q.z, q.w)
+                    .to_euler(glam::EulerRot::YXZ).0.to_degrees();
+                let yaw_before = Quat::from_xyzw(orientation.x, orientation.y, orientation.z, orientation.w)
+                    .to_euler(glam::EulerRot::YXZ).0.to_degrees();
+                info!(
+                    "recenter {ty:?}: head yaw {yaw_before:.1} deg in the reference space -> {yaw_after:.1} deg in the new adjusted space; anchor pos ({:.2}, {:.2}, {:.2}); game universe {game_universe:?}",
+                    position.x, position.y, position.z
+                );
+            }
