From ed77ef87c205cf408cd04abd35b996f5c18455fa Mon Sep 17 00:00:00 2001
From: Wintch <nikolai.viktorovich@gmail.com>
Date: Sun, 30 Aug 2026 06:24:40 -0300
Subject: [PATCH] openxr_data: recentre diagnostics -- yaw before/after each
 reset, game universe, game Reset/SetTrackingSpace calls, opt-in served-yaw
 log

Every reset_tracking_space logs the head yaw in the reference space and in the new adjusted
space plus the universe the game selected; IVRChaperone::ResetZeroPose and
IVRCompositor::SetTrackingSpace log their calls; XRIZER_LOG_SERVED_YAW=1 logs the yaw served to
the game once a second. Written for the 3dof booth question (the donning recentre logs a fire but
the cockpit stays turned): the resets are correct (72/155/130 deg -> 0.0 in the adjusted space);
what moves is the 3dof head yaw itself, 80-115 deg within a second after the fire while the wearer
reports holding still. Record: reverb-g2 docs/80, 2026-08-30 entry.
---
 src/chaperone.rs   |  1 +
 src/compositor.rs  |  2 ++
 src/openxr_data.rs | 48 ++++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 51 insertions(+)

diff --git a/src/chaperone.rs b/src/chaperone.rs
index 1f0353f..34a0b17 100644
--- a/src/chaperone.rs
+++ b/src/chaperone.rs
@@ -21,6 +21,7 @@ impl Chaperone {
 
 impl vr::IVRChaperone004_Interface for Chaperone {
     fn ResetZeroPose(&self, origin: vr::ETrackingUniverseOrigin) {
+        log::info!("game called IVRChaperone::ResetZeroPose({origin:?})");
         self.openxr.reset_tracking_space(origin);
     }
 
diff --git a/src/compositor.rs b/src/compositor.rs
index b9d7492..525ea8e 100644
--- a/src/compositor.rs
+++ b/src/compositor.rs
@@ -1158,6 +1158,7 @@ impl vr::IVRCompositor029_Interface for Compositor {
         // 0008: external recenter trigger, polled here so it works for every title (Input is
         // only constructed once a game asks for IVRInput). No session_data guard is held here.
         self.openxr.poll_recenter_trigger();
+        self.openxr.log_served_yaw();
         if let Some(input) = self.input.get() {
             input.frame_start_update();
         }
@@ -1175,6 +1176,7 @@ impl vr::IVRCompositor029_Interface for Compositor {
     }
 
     fn SetTrackingSpace(&self, origin: vr::ETrackingUniverseOrigin) {
+        log::info!("game called IVRCompositor::SetTrackingSpace({origin:?})");
         self.openxr.set_tracking_space(origin);
     }
 }
diff --git a/src/openxr_data.rs b/src/openxr_data.rs
index 9d301d5..4d49402 100644
