     in_progress: Mutex<InProgressFrame>,
-    /// Ring buffer of the last [`FRAME_TIMING_HISTORY_LEN`] completed frames, oldest first,
-    /// used to answer `GetFrameTiming`/`GetFrameTimings`.
-    history: Mutex<VecDeque<FrameTimingEntry>>,
+    /// Ring of the last [`FRAME_TIMING_HISTORY_LEN`] completed frames, used to answer
+    /// `GetFrameTiming`/`GetFrameTimings` without putting the reader on the frame path.
+    history: FrameTimingRing,
+}
+
+/// A ring of completed frames that a reader can sample without blocking the frame path.
+///
+/// WHY NOT ONE MUTEX, because that is what this replaced. `GetFrameTiming` is not a rare call:
+/// a benchmark asks for it every frame, and an overlay of the fpsVR class polls it continuously.
+/// With a single mutex around the whole history, that reader shares a lock with
+/// `WaitGetPoses`/`Submit`/`PostPresentHandoff` -- so a caller merely *asking* what happened can
+/// stall the frame that is happening. That is a latency hazard regardless of who wins the lock,
+/// and it is the reason the first honest-timing implementation was reverted (xrizer 782e72b).
+///
+/// (The freeze that prompted that revert was NOT this: it was later reproduced on the stub build
+/// too, and reproduced again on Windows/SteamVR in 2026-08-19's capture, so it belongs to the
+/// benchmark's own second-run path. The lock shape was still real, and is fixed here rather than
+/// left as a reason to keep the timing fictional.)
+///
+/// One lock per slot instead. The writer touches exactly the slot it is filling; a reader
+/// touches exactly the slot it is asked for. They can only meet on the same slot, which needs
+/// the reader to be a full ring -- 128 frames, ~1.4 s at 90 Hz -- behind the writer, and both
+/// critical sections are a copy of a handful of floats. Deliberately NOT a seqlock: that is the
+/// textbook answer and it would make the writer strictly wait-free, but it needs `UnsafeCell`
+/// and hand-reasoned orderings, and nothing measured here justifies that yet. If contention is
+/// ever actually observed, the seqlock is the named upgrade.
+struct FrameTimingRing {
+    slots: [RwLock<FrameTimingEntry>; FRAME_TIMING_HISTORY_LEN],
+    /// Total frames ever completed. `count % LEN` is the next slot to write, and the value
+    /// doubles as "how much history exists", so no separate length needs to stay in sync.
+    count: AtomicU64,
+}
+
+impl Default for FrameTimingRing {
+    fn default() -> Self {
+        Self {
+            slots: std::array::from_fn(|_| RwLock::new(FrameTimingEntry::default())),
+            count: AtomicU64::new(0),
+        }
+    }
+}
+
+impl FrameTimingRing {
+    /// Number of frames available to read, saturating at the ring size.
+    fn len(&self) -> usize {
+        (self.count.load(Ordering::Acquire) as usize).min(FRAME_TIMING_HISTORY_LEN)
+    }
+
+    fn push(&self, entry: FrameTimingEntry) {
+        let idx = (self.count.load(Ordering::Relaxed) as usize) % FRAME_TIMING_HISTORY_LEN;
+        *self.slots[idx].write().unwrap() = entry;
+        // Published last, with Release, so a reader that observes the new count also observes
+        // the slot contents it points at.
+        self.count.fetch_add(1, Ordering::Release);
+    }
+
+    /// `frames_ago` = 0 is the most recently completed frame. `None` once it runs past the
+    /// history that exists.
+    fn get(&self, frames_ago: usize) -> Option<FrameTimingEntry> {
+        let count = self.count.load(Ordering::Acquire) as usize;
+        if frames_ago >= count.min(FRAME_TIMING_HISTORY_LEN) {
+            return None;
+        }
+        let idx = (count - 1 - frames_ago) % FRAME_TIMING_HISTORY_LEN;
+        Some(*self.slots[idx].read().unwrap())
+    }
 }
 
