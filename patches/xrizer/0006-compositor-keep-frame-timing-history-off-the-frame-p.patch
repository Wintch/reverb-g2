+    /// The property the whole ring exists for: a reader hammering the history the way a
+    /// benchmark or an fpsVR-class overlay does must never block the writer, and must never
+    /// observe a half-written frame.
+    ///
+    /// Every field of a pushed entry is derived from its index, so a torn read is detectable
+    /// without depending on timing: any entry whose fields disagree with each other was
+    /// assembled from two different frames. The assertions hold no matter how the two threads
+    /// interleave, so this is a real concurrency test and not a flaky one.
+    #[test]
+    fn frame_timing_ring_reads_do_not_block_or_tear() {
+        use std::sync::Arc;
+
+        const PUSHES: u32 = 20_000;
+        let ring = Arc::new(FrameTimingRing::default());
+
+        let writer = {
+            let ring = ring.clone();
+            std::thread::spawn(move || {
+                for i in 0..PUSHES {
+                    ring.push(FrameTimingEntry {
+                        frame_index: i,
+                        system_time_seconds: i as f64,
+                        client_frame_interval_ms: i as f32,
+                        wait_get_poses_called_ms: i as f32,
+                        new_poses_ready_ms: i as f32,
+                        submit_frame_ms: i as f32,
+                        present_call_cpu_ms: i as f32,
+                    });
+                }
+            })
+        };
+
+        let mut reads = 0u32;
+        while !writer.is_finished() {
+            for ago in 0..FRAME_TIMING_HISTORY_LEN {
+                let Some(e) = ring.get(ago) else { break };
+                let i = e.frame_index;
+                assert_eq!(e.system_time_seconds, i as f64, "torn read at {i}");
+                assert_eq!(e.client_frame_interval_ms, i as f32, "torn read at {i}");
+                assert_eq!(e.wait_get_poses_called_ms, i as f32, "torn read at {i}");
+                assert_eq!(e.new_poses_ready_ms, i as f32, "torn read at {i}");
+                assert_eq!(e.submit_frame_ms, i as f32, "torn read at {i}");
+                assert_eq!(e.present_call_cpu_ms, i as f32, "torn read at {i}");
+                reads += 1;
+            }
+        }
+        writer.join().unwrap();
+
+        assert!(reads > 0, "the reader never got to run; the test proved nothing");
+        assert_eq!(ring.len(), FRAME_TIMING_HISTORY_LEN);
+        // Newest entry is the last one pushed, and the ring holds exactly the last LEN frames.
+        assert_eq!(ring.get(0).unwrap().frame_index, PUSHES - 1);
+        assert_eq!(
+            ring.get(FRAME_TIMING_HISTORY_LEN - 1).unwrap().frame_index,
+            PUSHES - FRAME_TIMING_HISTORY_LEN as u32
+        );
+        assert!(ring.get(FRAME_TIMING_HISTORY_LEN).is_none());
+    }
+
