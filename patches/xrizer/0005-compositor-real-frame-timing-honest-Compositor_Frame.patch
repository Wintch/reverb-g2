+/// Real, per-frame timing data, built up over the course of one WaitGetPoses -> Submit(s) ->
+/// PostPresentHandoff cycle and then frozen into a [`FrameTimingEntry`] when the frame is
+/// actually handed off to the runtime. See [`write_frame_timing`]'s doc comment for what each
+/// field honestly measures.
 struct FrameMetrics {
     system_start: Instant,
     index: AtomicU32,
     time: AtomicF64,
+    /// Wall-clock time of the previous `WaitGetPoses` call, used to compute
+    /// `m_flClientFrameIntervalMs` as a *real* measured interval instead of a constant derived
+    /// from the nominal refresh rate.
+    last_wait_get_poses_call: Mutex<Option<Instant>>,
+    /// Accumulates measurements for the frame currently being built, from the moment
+    /// `WaitGetPoses` starts it until `PostPresentHandoff` freezes it into `history`.
+    in_progress: Mutex<InProgressFrame>,
+    /// Ring buffer of the last [`FRAME_TIMING_HISTORY_LEN`] completed frames, oldest first,
+    /// used to answer `GetFrameTiming`/`GetFrameTimings`.
+    history: Mutex<VecDeque<FrameTimingEntry>>,
+}
+
+#[derive(Default, Clone, Copy)]
+struct InProgressFrame {
+    client_frame_interval_ms: f32,
+    /// Real wall-clock time spent blocked inside the OpenXR `xrWaitFrame` call for this frame
+    /// (i.e. `FrameController::wait_frame`'s `self.waiter.wait()`).
+    wait_get_poses_called_ms: f32,
+    /// In xrizer's model, poses are considered "ready" the instant `xrWaitFrame` returns (there
+    /// is no further asynchronous pose-computation step to wait on), so this is always 0.0 --
+    /// kept as a distinct field to match the OpenVR struct rather than folding it into
+    /// `wait_get_poses_called_ms`.
+    new_poses_ready_ms: f32,
+    /// Real, summed wall-clock CPU time spent inside `IVRCompositor::Submit` for both eyes this
+    /// frame (the texture copy/blit into the OpenXR swapchain).
+    submit_frame_ms: f32,
+}
+
+/// A frozen snapshot of one completed frame's real timing data.
+#[derive(Default, Clone, Copy)]
+struct FrameTimingEntry {
+    frame_index: u32,
+    system_time_seconds: f64,
+    client_frame_interval_ms: f32,
+    wait_get_poses_called_ms: f32,
+    new_poses_ready_ms: f32,
+    submit_frame_ms: f32,
+    /// Real wall-clock CPU time spent inside the `xrEndFrame` call (the closest thing xrizer
+    /// has to OpenVR's "present").
+    present_call_cpu_ms: f32,
+}
+
+/// Writes `entry`'s real data into a `Compositor_FrameTiming` at `timing`.
+///
+/// ## What is real, what is derived, and what is honestly zero
+///
+/// GPU timing (`m_flPreSubmitGpuMs`, `m_flPostSubmitGpuMs`, `m_flCompositorRenderGpuMs`) is left
+/// at an honest `0.0`: xrizer does not own a GPU timeline spanning the app's own rendering. The
+/// app submits its swapchain image on its own graphics queue, and by the time control reaches
+/// `Submit`/`PostPresentHandoff` there's no fence xrizer waits on to bracket the app's GPU work
+/// with `vkCmdWriteTimestamp` -- the only GPU work xrizer itself could time is its own texture
+/// copy/blit into the OpenXR swapchain, and reporting *that* as "app render time" would be its
+/// own kind of dishonest. `0.0` is a real "not measured", not a plausible-looking fake number.
+///
+/// `m_flTotalRenderGpuMs` -- the field OpenVR Benchmark and fpsVR-style tools read to compute
+/// FPS as `1000 / m_flTotalRenderGpuMs` -- is deliberately filled with the real, measured
+/// CPU-side frame interval (WaitGetPoses-to-WaitGetPoses) instead. It's not a GPU measurement,
+/// but unlike the old hardcoded `9.0` it actually varies with real load and converges on the
+/// real frame rate, which is what every consumer of this field actually cares about.
+///
+/// CPU timings (`m_flSubmitFrameMs`, `m_flPresentCallCpuMs`, `m_flCompositorRenderCpuMs`,
+/// `m_flWaitGetPosesCalledMs`, `m_flClientFrameIntervalMs`) are real wall-clock measurements
+/// taken around the corresponding calls (see `FrameTimingEntry`/`InProgressFrame`). xrizer does
+/// not distinguish a separate "compositor render" phase from the `xrEndFrame` submission call,
+/// so both `m_flPresentCallCpuMs` and `m_flCompositorRenderCpuMs` report the same real
+/// `xrEndFrame` duration.
+///
+/// Everything else (`m_flCompositorIdleCpuMs`, `m_flWaitForPresentCpuMs`,
+/// `m_flNewFrameReadyMs`, `m_flCompositorUpdateStartMs`/`EndMs`/`RenderStartMs`,
+/// `m_nNumDroppedFrames`, `m_nNumMisPresented`, `m_nReprojectionFlags`) has no real signal
+/// available and is set to an honest `0`, never a fabricated nonzero constant.
+unsafe fn write_frame_timing(
+    timing: *mut vr::Compositor_FrameTiming,
+    entry: &FrameTimingEntry,
+    client_frame_interval_fallback_ms: f32,
+) {
+    macro_rules! set {
+        ($member:ident, $value:expr) => {{
+            let ptr = &raw mut (*timing).$member;
+            ptr.write_unaligned($value)
+        }};
+    }
+
+    let frame_interval_ms = if entry.client_frame_interval_ms > 0.0 {
+        entry.client_frame_interval_ms
+    } else {
+        client_frame_interval_fallback_ms
+    };
+
+    unsafe {
+        set!(m_nFrameIndex, entry.frame_index);
+        set!(m_nNumFramePresents, 1);
+        set!(m_nNumMisPresented, 0);
+        set!(m_nNumDroppedFrames, 0);
+        set!(m_nReprojectionFlags, 0);
+        set!(m_flSystemTimeInSeconds, entry.system_time_seconds);
+
+        set!(m_flPreSubmitGpuMs, 0.0);
+        set!(m_flPostSubmitGpuMs, 0.0);
+        set!(m_flTotalRenderGpuMs, frame_interval_ms);
+
+        set!(m_flCompositorRenderGpuMs, 0.0);
+        set!(m_flCompositorRenderCpuMs, entry.present_call_cpu_ms);
+        set!(m_flCompositorIdleCpuMs, 0.0);
+
+        set!(m_flClientFrameIntervalMs, frame_interval_ms);
+        set!(m_flPresentCallCpuMs, entry.present_call_cpu_ms);
+        set!(m_flWaitForPresentCpuMs, 0.0);
+        set!(m_flSubmitFrameMs, entry.submit_frame_ms);
+
+        set!(m_flWaitGetPosesCalledMs, entry.wait_get_poses_called_ms);
+        set!(m_flNewPosesReadyMs, entry.new_poses_ready_ms);
+        set!(m_flNewFrameReadyMs, 0.0); // second call to IVRCompositor::Submit
+        set!(m_flCompositorUpdateStartMs, 0.0);
+        set!(m_flCompositorUpdateEndMs, 0.0);
+        set!(m_flCompositorRenderStartMs, 0.0);
+    }
 }
 
