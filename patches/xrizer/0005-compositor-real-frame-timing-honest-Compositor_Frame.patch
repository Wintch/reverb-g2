+    /// "Only the first entry's m_nSize needs to be set, as the rest will be inferred from
+    /// that." -- we take that literally: the first entry's size is also the per-entry stride
+    /// used to walk the caller's array, exactly like `GetFrameTiming` tolerates a
+    /// smaller-than-current struct.
+    fn GetFrameTimings(&self, pTiming: *mut vr::Compositor_FrameTiming, nFrames: u32) -> u32 {
+        if pTiming.is_null() || !pTiming.is_aligned() || nFrames == 0 {
+            return 0;
+        }
+
+        let size = unsafe { (&raw const (*pTiming).m_nSize).read() } as usize;
+        let min_size = offset_of!(vr::Compositor_FrameTiming, m_HmdPose)
+            + std::mem::size_of::<vr::TrackedDevicePose_t>();
+        if size < min_size {
+            return 0;
+        }
+
+        let refresh_rate_ms = 1000.0 / self.openxr.get_refresh_rate();
+        let history = self.metrics.history.lock().unwrap();
+        let count = (nFrames as usize).min(history.len());
+        let start = history.len() - count;
+
+        // Ascending order (oldest to newest), last entry is the most recent frame, per the
+        // documented contract.
+        for (i, entry) in history.iter().skip(start).take(count).enumerate() {
+            let out = unsafe { pTiming.byte_add(i * size) };
+            unsafe { write_frame_timing(out, entry, refresh_rate_ms) };
+        }
+
+        count as u32
     }
