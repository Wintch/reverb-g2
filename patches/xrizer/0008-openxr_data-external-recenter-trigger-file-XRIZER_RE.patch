+    /// reverb-g2 0008: external recenter trigger. The dashboard (or any script) touches
+    /// `$XRIZER_RECENTER_FILE` (default `$HOME/vr/logs/xrizer-recenter`); the compositor calls
+    /// this once per WaitGetPoses -- for every title, whether or not it ever touches IVRInput --
+    /// and every ~30th call (the brightness gain's cadence) looks for the file. Found and the
+    /// session is FOCUSED: remove it and recenter BOTH play-space origins on the current head
+    /// pose -- Standing keeps the floor height, Seated takes the head height; stronger than
+    /// SteamVR, which never moves Standing, because at a booth the STAGE origin is wherever
+    /// Basalt happened to start the session (reverb-g2 docs/80 "the anchor test"), and the
+    /// title's universe is not known here. Headset-only titles (Dreams of Dali) have no
+    /// button to hold for the 0001 shortcut. Guards: a trigger older than 10 s is discarded
+    /// unused (a touch made with no title running cannot recenter the next launch); a session
+    /// that is not FOCUSED leaves the file in place (Dali's bootstrap session is torn down
+    /// ~30 ms after its first frame -- a reset consumed there would be lost with it); with
+    /// XR_EXT_user_presence enabled, a doffed headset ignores the trigger; and
+    /// reset_tracking_space now refuses an invalid head pose. Must be called with no
+    /// session_data guard held: reset_tracking_space takes the write lock.
+    pub fn poll_recenter_trigger(&self) {
+        use std::sync::atomic::AtomicU64;
+        static FRAME: AtomicU64 = AtomicU64::new(0);
+        if FRAME.fetch_add(1, Ordering::Relaxed) % 30 != 0 {
+            return;
+        }
+        let path = std::env::var("XRIZER_RECENTER_FILE").unwrap_or_else(|_| {
+            format!(
+                "{}/vr/logs/xrizer-recenter",
+                std::env::var("HOME").unwrap_or_default()
+            )
+        });
+        let Ok(meta) = std::fs::metadata(&path) else {
+            return;
+        };
+        let age = meta
+            .modified()
+            .ok()
+            .and_then(|t| t.elapsed().ok())
+            .unwrap_or_default();
+        if age > std::time::Duration::from_secs(10) {
+            let _ = std::fs::remove_file(&path);
+            warn!("recenter trigger {path} is {age:?} old -- stale, discarded");
+            return;
+        }
+        let state = self.session_data.get().state; // read guard dropped at the semicolon
+        if state != xr::SessionState::FOCUSED {
+            debug!("recenter trigger {path} seen in session state {state:?} -- waiting for FOCUSED");
+            return;
+        }
+        // Remove first: a recenter that fails must not re-fire on every poll.
+        if let Err(e) = std::fs::remove_file(&path) {
+            warn!("recenter trigger {path}: could not remove ({e}) -- ignoring");
+            return;
+        }
+        if self.enabled_extensions.ext_user_presence && !self.user_present.load(Ordering::Relaxed) {
+            warn!("recenter trigger {path}: headset not worn -- ignored");
+            return;
+        }
+        info!("recenter trigger {path} -- recentering play space (Standing + Seated) on the current head pose");
+        self.reset_tracking_space(vr::ETrackingUniverseOrigin::Standing);
+        self.reset_tracking_space(vr::ETrackingUniverseOrigin::Seated);
+    }
+
