diff --git a/src/input/legacy.rs b/src/input/legacy.rs
index 3099735..ebf89aa 100644
--- a/src/input/legacy.rs
+++ b/src/input/legacy.rs
@@ -6,10 +6,11 @@ use crate::{
     },
     openxr_data::{self},
 };
-use log::{debug, trace, warn};
+use log::{debug, info, trace, warn};
 use openvr as vr;
 use openxr as xr;
 use std::sync::atomic::{AtomicBool, AtomicU32, Ordering};
+use std::time::Instant;
 
 #[derive(Default)]
 pub(super) struct LegacyState {
@@ -298,6 +299,64 @@ impl<C: openxr_data::Compositor> Input<C> {
 
         true
     }
+
+    /// No dashboard/vrmonitor exists in this reimplementation, so there's normally no way
+    /// to recenter a game that doesn't expose its own in-game recenter option -- SLAM
+    /// origin drift just stays baked in for the whole session. Real SteamVR provides a
+    /// global "hold the menu button" shortcut for this via its dashboard, intercepting the
+    /// button before the game ever sees it -- this reproduces that using system_recenter, a
+    /// dedicated action bound only to the real physical menu button where one exists,
+    /// deliberately never read by get_legacy_controller_state above, so games never see it
+    /// (first version of this reused app_menu directly and broke in-game input on real
+    /// hardware -- games received real menu-press events during every recenter hold and got
+    /// stuck in their own paused/menu state). Called once per frame from
+    /// Input::frame_start_update, regardless of which game is running, so it works the same
+    /// way real SteamVR's shortcut does.
+    pub fn check_system_recenter_hold(&self) {
+        let held = {
+            let data = self.openxr.session_data.get();
+            let Some(legacy) = data.input_data.get_legacy_actions() else {
+                return;
+            };
+            [openxr_data::Hand::Left, openxr_data::Hand::Right]
+                .into_iter()
+                .any(|hand| {
+                    let hand_path = self.get_subaction_path(hand);
+                    legacy
+                        .actions
+                        .system_recenter
+                        .state(&data.session, hand_path)
+                        .map(|s| s.current_state)
+                        .unwrap_or(false)
+                })
+        }; // session_data read guard dropped here -- reset_tracking_space below takes a write lock
+
+        let mut hold_since = self.system_recenter_hold.lock().unwrap();
+        if held {
+            let since = *hold_since.get_or_insert_with(Instant::now);
+            if !self.system_recenter_fired.load(Ordering::Relaxed) && since.elapsed() >= recenter_hold_duration()
+            {
+                info!(
+                    "menu button held {:?} -- recentering play space",
+                    since.elapsed()
+                );
+                self.openxr
+                    .reset_tracking_space(vr::ETrackingUniverseOrigin::Standing);
+                self.system_recenter_fired.store(true, Ordering::Relaxed);
+            }
+        } else {
+            *hold_since = None;
+            self.system_recenter_fired.store(false, Ordering::Relaxed);
+        }
+    }
+}
+
+fn recenter_hold_duration() -> std::time::Duration {
+    std::env::var("XRIZER_RECENTER_HOLD_SECS")
+        .ok()
+        .and_then(|s| s.parse::<f32>().ok())
+        .map(std::time::Duration::from_secs_f32)
+        .unwrap_or(std::time::Duration::from_secs(3))
 }
 
