+    // wiring the real menu button in wouldn't be visible to games without also suppressing
+    // it there, and games use ApplicationMenu for their own purposes (e.g. pausing).
+    pub system_recenter: Action<bool, M>,
     pub a: Action<bool, M>,
     pub trigger_click: Action<bool, M>,
     pub squeeze_click: Action<bool, M>,
@@ -369,6 +434,7 @@ impl LegacyBindings {
                 .into_iter()
                 .map(|path| xr::Binding::new(&pose_data.grip, path)),
             app_menu,
+            system_recenter,
             a,
             trigger_click,
             squeeze_click,
@@ -405,6 +471,9 @@ impl LegacyActionData {
             app_menu: set
                 .create_action("app-menu", "Application Menu", &leftright)
