@@ -274,15 +274,26 @@ impl<C: Compositor> OpenXrData<C> {
             ..
         } = &mut **guard;
 
-        let reset_space = |ref_space, adjusted_space: &mut xr::Space, ty| {
+        let reset_space = |ref_space, adjusted_space: &mut xr::Space, ty, preserve_height: bool| {
             let xr::Posef {
-                position,
