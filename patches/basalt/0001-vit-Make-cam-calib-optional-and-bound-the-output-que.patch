From b3ebbe5c27df82ef9894e0c00a64c1f3b26a1018 Mon Sep 17 00:00:00 2001
From: iam <iam@iashur.internal>
Date: Wed, 12 Aug 2026 10:38:12 -0300
Subject: [PATCH] vit: Make --cam-calib optional, and bound the output queue in
 every path

Two independent changes to the VIT tracker entry point, both found while
bringing up a Reverb G2 (4 fisheye cameras) through Monado.

1. --cam-calib is no longer required. A unified config file can now carry ONLY
   pipeline settings, with the calibration still arriving through
   add_camera_calibration/add_imu_calibration. Before this, tuning one VioConfig
   parameter against a real device meant first re-expressing that device's whole
   calibration in Basalt's format -- work, plus a second place to get it wrong.
   With this, a config sweep is one line per run. The sweep is what showed that
   the default detection settings are too sparse for the G2's fisheye cameras:
   grid_size 30 / num_points_cell 3 / min_threshold 3 took static drift from
   thousands of metres to 0.72 m at 60 s, where no single one of the three was
   enough on its own.

2. monado_out_state_queue.set_capacity(32) now runs in every path, not only when
   a unified config file was given. pop_state() implements "push the newest, drop
   the oldest" as `while (!try_push(x)) pop(_)`, which silently does nothing on an
   unbounded queue -- so the caller-driven path (add_cam/imu_calibration, i.e. how
   Monado drives this by default) let the queue grow without limit instead of
   dropping stale states.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 src/vit/vit_tracker.cpp | 21 ++++++++++++++++++---
 1 file changed, 18 insertions(+), 3 deletions(-)

diff --git a/src/vit/vit_tracker.cpp b/src/vit/vit_tracker.cpp
index d85e81d..5be3270 100644
--- a/src/vit/vit_tracker.cpp
+++ b/src/vit/vit_tracker.cpp
@@ -168,6 +168,14 @@ struct Tracker::Implementation {
     ASSERT(cam_count > 1, "Basalt doesn't support running with %d cameras", cam_count);
     calib_data_ready.cam.resize(cam_count, false);
 
+    // Bound the output queue in every path, not only when a unified config file was
+    // given. pop_state() implements "push the newest, drop the oldest" with
+    // `while (!try_push(x)) pop(_)`, which is a no-op on an unbounded queue: the
+    // caller-driven path (add_cam/imu_calibration, i.e. how Monado drives this by
+    // default) therefore let the queue grow without limit instead of dropping stale
+    // states. Same capacity as the config-file path used.
+    monado_out_state_queue.set_capacity(32);
+
     if (config->file == nullptr) {
       // For the pipeline to work now, the user will need to use add_cam/imu_calibration
       return;
@@ -176,9 +184,16 @@ struct Tracker::Implementation {
     load_unified_config(config->file);
 
     vio_config.load(config_path);
-    load_calibration_data(cam_calib_path);
 
-    monado_out_state_queue.set_capacity(32);
+    // cam-calib is optional now. Leaving it out is what lets a unified config file carry
+    // ONLY pipeline settings while the calibration still arrives through
+    // add_camera_calibration/add_imu_calibration -- i.e. sweep the VIO config against a
+    // real device without hand-writing its calibration in Basalt's own format first.
+    if (!cam_calib_path.empty()) {
+      load_calibration_data(cam_calib_path);
+    } else {
+      std::cout << "Basalt: no cam-calib in the config file, expecting calibration from the caller\n";
+    }
   }
 
   static vit::Result get_supported_extensions(vit::TrackerExtensionSet *out_exts) {
@@ -215,7 +230,7 @@ struct Tracker::Implementation {
     CLI::App app{"Options for the Basalt SLAM Tracker"};
 
     app.add_option("--show-gui", show_gui, "Show GUI");
-    app.add_option("--cam-calib", cam_calib_path, "Ground-truth camera calibration used for simulation.")->required();
+    app.add_option("--cam-calib", cam_calib_path, "Ground-truth camera calibration used for simulation.");
     app.add_option("--config-path", config_path, "Path to config file.")->required();
     app.add_option("--marg-data", marg_data_path, "Path to folder where marginalization data will be stored.");
     app.add_option("--print-queue", print_queue, "Poll and print for queue sizes.");
-- 
