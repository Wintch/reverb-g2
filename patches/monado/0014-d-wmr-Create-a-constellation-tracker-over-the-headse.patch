 #include "xrt/xrt_device.h"
 #include "xrt/xrt_frame.h"
 #include "xrt/xrt_prober.h"
@@ -54,6 +56,18 @@ struct wmr_headset_descriptor
 	void (*screen_enable_func)(struct wmr_hmd *wh, bool enable);
 };
 
+/*!
+ * Adapts the headset's own tracked pose to the interface the constellation tracker wants for
+ * the origin of a camera mosaic.
+ *
+ * @implements t_constellation_tracker_tracking_source
+ */
+struct wmr_constellation_head_source
+{
+	struct t_constellation_tracker_tracking_source base;
+	struct wmr_hmd *wh;
+};
+
 /*!
  * @implements xrt_device
  */
@@ -146,6 +160,21 @@ struct wmr_hmd
 		bool imu2me;
 	} tracking;
 
+	//! Optional constellation (LED) tracking of the controllers, see WMR_CONSTELLATION_CONTROLLERS.
+	struct
+	{
+		//! NULL unless the option is on and setup succeeded.
+		struct t_constellation_tracker *tracker;
+
+		/*!
+		 * The camera mosaic's origin. Unlike a Rift, whose sensors sit on a desk, the WMR
+		 * tracking cameras are bolted to the headset and move with it, so the mosaic's origin
+		 * has to follow the head pose instead of being a fixed point in the room. This feeds
+		 * that pose to the tracker.
+		 */
+		struct wmr_constellation_head_source head_source;
+	} constellation;
+
 	//! Whether to track the HMD with 6dof SLAM or fallback to the `fusion` 3dof tracker
 	bool slam_over_3dof;
 
