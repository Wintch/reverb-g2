From b05e1698c6fd9d101fdc697344748301773777cd Mon Sep 17 00:00:00 2001
From: brunduk <nikolai.viktorovich@gmail.com>
Date: Mon, 12 Oct 2026 22:09:14 -0300
Subject: [PATCH] d/wmr: Make the presence stale notice fire, and say what it
 means
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

0087's PRESENCE_STALE_NS was 30 * U_TIME_1S_IN_NS, computed in int: it
overflows (gcc: "integer overflow in expression of type 'int' results in
'-64771072'"), and converted to uint64_t the threshold became ~1.8e19 ns,
so the stale-channel notice never fired. Compute it in 64 bits.

With the notice live, two more things matter. The proximity message is
sent on change, so a headset that stays on or off is silent too: the
notice now says that silence is normal by itself and only means a frozen
presence when the companion also logs read errors. And its throttle
counter is reset when updates resume, so a later silence in the same
session gets its own first notice instead of waiting for the cumulative
count to reach the next multiple of 5000.

Found by the 2026-10-12 code review (reverb-g2 docs/147 §9, M12-1, M12-2).

Signed-off-by: brunduk <nikolai.viktorovich@gmail.com>
---
 src/xrt/drivers/wmr/wmr_hmd.c | 20 ++++++++++++++++----
 src/xrt/drivers/wmr/wmr_hmd.h |  4 +++-
 2 files changed, 19 insertions(+), 5 deletions(-)

diff --git a/src/xrt/drivers/wmr/wmr_hmd.c b/src/xrt/drivers/wmr/wmr_hmd.c
index cd9b2e945..5b5d4f10c 100644
--- a/src/xrt/drivers/wmr/wmr_hmd.c
+++ b/src/xrt/drivers/wmr/wmr_hmd.c
@@ -2621,15 +2621,27 @@ wmr_hmd_update_inputs(struct xrt_device *xdev)
 		 * channel went quiet, because T224 measured the companion surviving only ~1-3
 		 * minutes per session on degraded hardware -- long enough to look healthy at launch
 		 * and be gone by the time anyone tests the feature.
+		 *
+		 * The proximity message is sent on change, so silence alone does not mean the
+		 * channel died: a headset that simply stays on (or off) is silent too. The notice
+		 * says so, and leaves the diagnosis to the companion's own read-error log.
+		 *
+		 * The constant is computed in 64 bits: 30 * U_TIME_1S_IN_NS in int overflows, and
+		 * the wrapped value made the threshold ~1.8e19 ns, so this notice never fired.
 		 */
-		const uint64_t PRESENCE_STALE_NS = 30 * U_TIME_1S_IN_NS;
+		const uint64_t PRESENCE_STALE_NS = 30 * (uint64_t)U_TIME_1S_IN_NS;
+		if (wh->presence.last_update_ns != wh->presence.stale_since_update_ns) {
+			// A fresh update arrived since the last notice: count the next silence anew.
+			wh->presence.stale_since_update_ns = wh->presence.last_update_ns;
+			wh->presence.stale_log_count = 0;
+		}
 		if (wh->presence.last_update_ns != 0 && (now_ns - wh->presence.last_update_ns) > PRESENCE_STALE_NS) {
 			wh->presence.stale_log_count++;
 			if (wh->presence.stale_log_count == 1 || (wh->presence.stale_log_count % 5000) == 0) {
 				WMR_INFO(wh,
-				         "User presence: no proximity update for %llu s -- holding '%s'. The "
-				         "companion channel is the dependency here; if it is storming, this "
-				         "feature is effectively frozen, not reporting.",
+				         "User presence: no proximity change for %llu s -- holding '%s'. Normal "
+				         "for a headset that stays on or off; if the companion is also logging "
+				         "read errors, presence is frozen, not reporting.",
 				         (unsigned long long)((now_ns - wh->presence.last_update_ns) / U_TIME_1S_IN_NS),
 				         wh->presence.committed ? "WORN" : "NOT WORN");
 			}
diff --git a/src/xrt/drivers/wmr/wmr_hmd.h b/src/xrt/drivers/wmr/wmr_hmd.h
index a433cba08..ec831031f 100644
--- a/src/xrt/drivers/wmr/wmr_hmd.h
+++ b/src/xrt/drivers/wmr/wmr_hmd.h
@@ -196,8 +196,10 @@ struct wmr_hmd
 		uint64_t candidate_since_ns;
 		//! When the companion last delivered a proximity value at all. 0 = never.
 		uint64_t last_update_ns;
-		//! Throttle for the stale-channel notice.
+		//! Throttle for the stale-channel notice, counted per silent stretch.
 		uint64_t stale_log_count;
+		//! The last_update_ns the current silent stretch started from.
+		uint64_t stale_since_update_ns;
 	} presence;
 
 	struct hololens_sensors_packet packet;
-- 
2.47.3

