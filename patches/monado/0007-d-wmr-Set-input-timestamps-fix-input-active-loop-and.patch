From cc251f0be4da18903a42a772f2fa8fd4ef18f948 Mon Sep 17 00:00:00 2001
From: brunduk <nikolai.viktorovich@gmail.com>
Date: Wed, 5 Aug 2026 12:53:50 -0300
Subject: [PATCH 07/10] d/wmr: Set input timestamps, fix input-active loop and
 debug labels

- xrt_input::timestamp was never set, so OpenXR reported
  lastChangeTime == 0 for every WMR controller action. Stamp all inputs
  with the IMU timestamp of the packet the values came from, following
  what !2080 did for the qwerty driver.
- The input-activation loop wrote inputs[0] on every iteration. Harmless
  today only because u_device_allocate() pre-sets every input active;
  still wrong.
- The thumbstick x/y labels in the debug GUI were swapped.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Signed-off-by: brunduk <nikolai.viktorovich@gmail.com>
---
 src/xrt/drivers/wmr/wmr_controller_hp.c | 11 ++++++++---
 src/xrt/drivers/wmr/wmr_controller_og.c | 11 ++++++++---
 2 files changed, 16 insertions(+), 6 deletions(-)

diff --git a/src/xrt/drivers/wmr/wmr_controller_hp.c b/src/xrt/drivers/wmr/wmr_controller_hp.c
index ef17708d6..6d672b1e3 100644
--- a/src/xrt/drivers/wmr/wmr_controller_hp.c
+++ b/src/xrt/drivers/wmr/wmr_controller_hp.c
@@ -336,6 +336,11 @@ wmr_controller_hp_update_inputs(struct xrt_device *xdev)
 	xrt_inputs[WMR_CONTROLLER_INDEX_THUMBSTICK_CLICK].value.boolean = cur_inputs->thumbstick.click;
 	xrt_inputs[WMR_CONTROLLER_INDEX_THUMBSTICK].value.vec2 = cur_inputs->thumbstick.values;
 
+	// Without a timestamp OpenXR reports lastChangeTime == 0 for every WMR action.
+	for (uint32_t i = 0; i < xdev->input_count; i++) {
+		xrt_inputs[i].timestamp = (int64_t)wcb->last_imu_timestamp_ns;
+	}
+
 	os_mutex_unlock(&wcb->data_lock);
 
 	return XRT_SUCCESS;
@@ -397,7 +402,7 @@ wmr_controller_hp_create(struct wmr_controller_connection *conn,
 	}
 
 	for (uint32_t i = 0; i < wcb->base.input_count; i++) {
-		wcb->base.inputs[0].active = true;
+		wcb->base.inputs[i].active = true;
 	}
 
 	ctrl->last_inputs.imu.timestamp_ticks = 0;
@@ -417,8 +422,8 @@ wmr_controller_hp_create(struct wmr_controller_connection *conn,
 	u_var_add_f32(wcb, &ctrl->last_inputs.trigger, "input.trigger");
 	u_var_add_u8(wcb, &ctrl->last_inputs.battery, "input.battery");
 	u_var_add_bool(wcb, &ctrl->last_inputs.thumbstick.click, "input.thumbstick.click");
-	u_var_add_f32(wcb, &ctrl->last_inputs.thumbstick.values.x, "input.thumbstick.values.y");
-	u_var_add_f32(wcb, &ctrl->last_inputs.thumbstick.values.y, "input.thumbstick.values.x");
+	u_var_add_f32(wcb, &ctrl->last_inputs.thumbstick.values.x, "input.thumbstick.values.x");
+	u_var_add_f32(wcb, &ctrl->last_inputs.thumbstick.values.y, "input.thumbstick.values.y");
 	if (controller_type == XRT_DEVICE_TYPE_LEFT_HAND_CONTROLLER) {
 		u_var_add_bool(wcb, &ctrl->last_inputs.x_a, "input.x");
 		u_var_add_bool(wcb, &ctrl->last_inputs.y_b, "input.y");
diff --git a/src/xrt/drivers/wmr/wmr_controller_og.c b/src/xrt/drivers/wmr/wmr_controller_og.c
index a5c3d0b63..47d4ed29b 100644
--- a/src/xrt/drivers/wmr/wmr_controller_og.c
+++ b/src/xrt/drivers/wmr/wmr_controller_og.c
@@ -387,6 +387,11 @@ wmr_controller_og_update_inputs(struct xrt_device *xdev)
 	xrt_inputs[WMR_CONTROLLER_INDEX_TRACKPAD_TOUCH].value.boolean = cur_inputs->trackpad.touch;
 	xrt_inputs[WMR_CONTROLLER_INDEX_TRACKPAD].value.vec2 = cur_inputs->trackpad.values;
 
+	// Without a timestamp OpenXR reports lastChangeTime == 0 for every WMR action.
+	for (uint32_t i = 0; i < xdev->input_count; i++) {
+		xrt_inputs[i].timestamp = (int64_t)wcb->last_imu_timestamp_ns;
+	}
+
 	os_mutex_unlock(&wcb->data_lock);
 
 	return XRT_SUCCESS;
@@ -466,7 +471,7 @@ wmr_controller_og_create(struct wmr_controller_connection *conn,
 	}
 
 	for (uint32_t i = 0; i < wcb->base.input_count; i++) {
-		wcb->base.inputs[0].active = true;
+		wcb->base.inputs[i].active = true;
 	}
 
 	ctrl->last_inputs.imu.timestamp_ticks = 0;
@@ -478,8 +483,8 @@ wmr_controller_og_create(struct wmr_controller_connection *conn,
 	u_var_add_f32(wcb, &ctrl->last_inputs.trigger, "input.trigger");
 	u_var_add_u8(wcb, &ctrl->last_inputs.battery, "input.battery");
 	u_var_add_bool(wcb, &ctrl->last_inputs.thumbstick.click, "input.thumbstick.click");
-	u_var_add_f32(wcb, &ctrl->last_inputs.thumbstick.values.x, "input.thumbstick.values.y");
-	u_var_add_f32(wcb, &ctrl->last_inputs.thumbstick.values.y, "input.thumbstick.values.x");
+	u_var_add_f32(wcb, &ctrl->last_inputs.thumbstick.values.x, "input.thumbstick.values.x");
+	u_var_add_f32(wcb, &ctrl->last_inputs.thumbstick.values.y, "input.thumbstick.values.y");
 	u_var_add_bool(wcb, &ctrl->last_inputs.trackpad.click, "input.trackpad.click");
 	u_var_add_bool(wcb, &ctrl->last_inputs.trackpad.touch, "input.trackpad.touch");
 	u_var_add_f32(wcb, &ctrl->last_inputs.trackpad.values.x, "input.trackpad.values.x");
-- 
