From 979f0c47d01d4aa02f006f7902b2bcec3c087ac1 Mon Sep 17 00:00:00 2001
From: brunduk <nikolai.viktorovich@gmail.com>
Date: Tue, 4 Aug 2026 12:17:31 -0300
Subject: [PATCH 3/6] d/wmr: Fix controller input handling (sticks, grip click,
 haptic name, timestamps)

- Thumbsticks: the 0..0x0FFF range around a 0x07FF centre overshoots
  [-1, 1] on the negative end and was only clamped on the positive one;
  clamp both (OpenXR requires it). Add a small radial deadzone with
  rescale - the config block carries no stick centre calibration, so
  per-unit centre offset showed up as constant drift in apps.
- G2: squeeze click was assigned the analog squeeze float instead of the
  parsed squeeze_click button bit, so any grip pressure read as a click.
- G2: the haptic output advertised XRT_OUTPUT_NAME_WMR_HAPTIC while both
  binding profiles and bindings.json reference
  XRT_OUTPUT_NAME_G2_CONTROLLER_HAPTIC - haptic actions could never
  resolve. (Actually driving the motor still needs the wire command,
  which is not documented anywhere in-tree.)
- inputs[i] loop wrote index 0 repeatedly (harmless today, still wrong).
- Debug GUI thumbstick x/y labels were swapped.
- Set xrt_input::timestamp so OpenXR lastChangeTime is not always 0.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 src/xrt/drivers/wmr/wmr_controller_hp.c | 47 ++++++++++++++++++-------
 src/xrt/drivers/wmr/wmr_controller_og.c | 38 ++++++++++++++------
 2 files changed, 61 insertions(+), 24 deletions(-)

diff --git a/src/xrt/drivers/wmr/wmr_controller_hp.c b/src/xrt/drivers/wmr/wmr_controller_hp.c
index 6150bba7c..460a593d5 100644
--- a/src/xrt/drivers/wmr/wmr_controller_hp.c
+++ b/src/xrt/drivers/wmr/wmr_controller_hp.c
@@ -19,6 +19,7 @@
 #include <string.h>
 #include <assert.h>
 #include <errno.h>
+#include <math.h>
 
 #include "wmr_controller.h"
 
@@ -217,15 +218,26 @@ wmr_controller_hp_packet_parse(struct wmr_controller_hp *ctrl, const unsigned ch
 	int16_t stick_y = (nibbles >> 4);
 	stick_y += (read8(&p) << 4);
 
-	last_input->thumbstick.values.x = (float)(stick_x - 0x07FF) / 0x07FF;
-	if (last_input->thumbstick.values.x > 1.0f) {
-		last_input->thumbstick.values.x = 1.0f;
-	}
-
-	last_input->thumbstick.values.y = (float)(stick_y - 0x07FF) / 0x07FF;
-	if (last_input->thumbstick.values.y > 1.0f) {
-		last_input->thumbstick.values.y = 1.0f;
+	/* The raw range is 0..0x0FFF around a 0x07FF centre, so this scale overshoots
+	 * [-1, 1] by 1/2047 at the negative end too - clamp both ends, OpenXR requires
+	 * VEC2_MINUS_ONE_TO_ONE components to stay in range. */
+	float stick_fx = fminf(fmaxf((float)(stick_x - 0x07FF) / 0x07FF, -1.0f), 1.0f);
+	float stick_fy = fminf(fmaxf((float)(stick_y - 0x07FF) / 0x07FF, -1.0f), 1.0f);
+
+	/* Small radial deadzone: the controller config carries no stick centre
+	 * calibration, and per-unit centre offset otherwise shows up as constant
+	 * drift in apps. Rescaled so full deflection still reaches 1.0. */
+	const float deadzone = 0.05f;
+	const float mag = sqrtf(stick_fx * stick_fx + stick_fy * stick_fy);
+	if (mag < deadzone) {
+		stick_fx = stick_fy = 0.0f;
+	} else {
+		const float rescale = (mag - deadzone) / (1.0f - deadzone) / mag;
+		stick_fx = fminf(fmaxf(stick_fx * rescale, -1.0f), 1.0f);
+		stick_fy = fminf(fmaxf(stick_fy * rescale, -1.0f), 1.0f);
 	}
+	last_input->thumbstick.values.x = stick_fx;
+	last_input->thumbstick.values.y = stick_fy;
 
 	// Read trigger value (0x00 - 0xFF)
 	last_input->trigger = (float)read8(&p) / 0xFF;
@@ -328,12 +340,19 @@ wmr_controller_hp_update_inputs(struct xrt_device *xdev)
 	xrt_inputs[WMR_CONTROLLER_INDEX_HOME_CLICK].value.boolean = cur_inputs->home;
 	xrt_inputs[WMR_CONTROLLER_INDEX_X_A_CLICK].value.boolean = cur_inputs->x_a;
 	xrt_inputs[WMR_CONTROLLER_INDEX_Y_B_CLICK].value.boolean = cur_inputs->y_b;
-	xrt_inputs[WMR_CONTROLLER_INDEX_SQUEEZE_CLICK].value.boolean = cur_inputs->squeeze;
+	// squeeze_click is the parsed button bit; assigning the analog squeeze float here made
+	// any non-zero grip pressure read as a click.
+	xrt_inputs[WMR_CONTROLLER_INDEX_SQUEEZE_CLICK].value.boolean = cur_inputs->squeeze_click;
 	xrt_inputs[WMR_CONTROLLER_INDEX_SQUEEZE_VALUE].value.vec1.x = cur_inputs->squeeze;
 	xrt_inputs[WMR_CONTROLLER_INDEX_TRIGGER_VALUE].value.vec1.x = cur_inputs->trigger;
 	xrt_inputs[WMR_CONTROLLER_INDEX_THUMBSTICK_CLICK].value.boolean = cur_inputs->thumbstick.click;
 	xrt_inputs[WMR_CONTROLLER_INDEX_THUMBSTICK].value.vec2 = cur_inputs->thumbstick.values;
 
+	// Without a timestamp OpenXR reports lastChangeTime == 0 for every WMR action.
+	for (uint32_t i = 0; i < xdev->input_count; i++) {
+		xrt_inputs[i].timestamp = (int64_t)wcb->last_imu_timestamp_ns;
+	}
+
 	os_mutex_unlock(&wcb->data_lock);
 
 	return XRT_SUCCESS;
@@ -395,12 +414,14 @@ wmr_controller_hp_create(struct wmr_controller_connection *conn,
 	}
 
 	for (uint32_t i = 0; i < wcb->base.input_count; i++) {
-		wcb->base.inputs[0].active = true;
+		wcb->base.inputs[i].active = true;
 	}
 
 	ctrl->last_inputs.imu.timestamp_ticks = 0;
 
-	wcb->base.outputs[0].name = XRT_OUTPUT_NAME_WMR_HAPTIC;
+	// Must match what the binding profiles and bindings.json reference
+	// (XRT_OUTPUT_NAME_G2_CONTROLLER_HAPTIC) or the haptic action can never resolve.
+	wcb->base.outputs[0].name = XRT_OUTPUT_NAME_G2_CONTROLLER_HAPTIC;
 
 	wcb->base.binding_profiles = binding_profiles;
 	wcb->base.binding_profile_count = ARRAY_SIZE(binding_profiles);
@@ -413,8 +434,8 @@ wmr_controller_hp_create(struct wmr_controller_connection *conn,
 	u_var_add_f32(wcb, &ctrl->last_inputs.trigger, "input.trigger");
 	u_var_add_u8(wcb, &ctrl->last_inputs.battery, "input.battery");
 	u_var_add_bool(wcb, &ctrl->last_inputs.thumbstick.click, "input.thumbstick.click");
-	u_var_add_f32(wcb, &ctrl->last_inputs.thumbstick.values.x, "input.thumbstick.values.y");
-	u_var_add_f32(wcb, &ctrl->last_inputs.thumbstick.values.y, "input.thumbstick.values.x");
+	u_var_add_f32(wcb, &ctrl->last_inputs.thumbstick.values.x, "input.thumbstick.values.x");
+	u_var_add_f32(wcb, &ctrl->last_inputs.thumbstick.values.y, "input.thumbstick.values.y");
 	if (controller_type == XRT_DEVICE_TYPE_LEFT_HAND_CONTROLLER) {
 		u_var_add_bool(wcb, &ctrl->last_inputs.x_a, "input.x");
 		u_var_add_bool(wcb, &ctrl->last_inputs.y_b, "input.y");
diff --git a/src/xrt/drivers/wmr/wmr_controller_og.c b/src/xrt/drivers/wmr/wmr_controller_og.c
index a5c3d0b63..23988f4cd 100644
--- a/src/xrt/drivers/wmr/wmr_controller_og.c
+++ b/src/xrt/drivers/wmr/wmr_controller_og.c
@@ -273,15 +273,26 @@ wmr_controller_og_packet_parse(struct wmr_controller_og *ctrl, const unsigned ch
 	int16_t stick_y = (nibbles >> 4);
 	stick_y += (read8(&p) << 4);
 
-	last_input->thumbstick.values.x = (float)(stick_x - 0x07FF) / 0x07FF;
-	if (last_input->thumbstick.values.x > 1.0f) {
-		last_input->thumbstick.values.x = 1.0f;
-	}
-
-	last_input->thumbstick.values.y = (float)(stick_y - 0x07FF) / 0x07FF;
-	if (last_input->thumbstick.values.y > 1.0f) {
-		last_input->thumbstick.values.y = 1.0f;
+	/* The raw range is 0..0x0FFF around a 0x07FF centre, so this scale overshoots
+	 * [-1, 1] by 1/2047 at the negative end too - clamp both ends, OpenXR requires
+	 * VEC2_MINUS_ONE_TO_ONE components to stay in range. */
+	float stick_fx = fminf(fmaxf((float)(stick_x - 0x07FF) / 0x07FF, -1.0f), 1.0f);
+	float stick_fy = fminf(fmaxf((float)(stick_y - 0x07FF) / 0x07FF, -1.0f), 1.0f);
+
+	/* Small radial deadzone: the controller config carries no stick centre
+	 * calibration, and per-unit centre offset otherwise shows up as constant
+	 * drift in apps. Rescaled so full deflection still reaches 1.0. */
+	const float deadzone = 0.05f;
+	const float mag = sqrtf(stick_fx * stick_fx + stick_fy * stick_fy);
+	if (mag < deadzone) {
+		stick_fx = stick_fy = 0.0f;
+	} else {
+		const float rescale = (mag - deadzone) / (1.0f - deadzone) / mag;
+		stick_fx = fminf(fmaxf(stick_fx * rescale, -1.0f), 1.0f);
+		stick_fy = fminf(fmaxf(stick_fy * rescale, -1.0f), 1.0f);
 	}
+	last_input->thumbstick.values.x = stick_fx;
+	last_input->thumbstick.values.y = stick_fy;
 
 	// Read trigger value (0x00 - 0xFF)
 	last_input->trigger = (float)read8(&p) / 0xFF;
@@ -387,6 +398,11 @@ wmr_controller_og_update_inputs(struct xrt_device *xdev)
 	xrt_inputs[WMR_CONTROLLER_INDEX_TRACKPAD_TOUCH].value.boolean = cur_inputs->trackpad.touch;
 	xrt_inputs[WMR_CONTROLLER_INDEX_TRACKPAD].value.vec2 = cur_inputs->trackpad.values;
 
+	// Without a timestamp OpenXR reports lastChangeTime == 0 for every WMR action.
+	for (uint32_t i = 0; i < xdev->input_count; i++) {
+		xrt_inputs[i].timestamp = (int64_t)wcb->last_imu_timestamp_ns;
+	}
+
 	os_mutex_unlock(&wcb->data_lock);
 
 	return XRT_SUCCESS;
@@ -466,7 +482,7 @@ wmr_controller_og_create(struct wmr_controller_connection *conn,
 	}
 
 	for (uint32_t i = 0; i < wcb->base.input_count; i++) {
-		wcb->base.inputs[0].active = true;
+		wcb->base.inputs[i].active = true;
 	}
 
 	ctrl->last_inputs.imu.timestamp_ticks = 0;
@@ -478,8 +494,8 @@ wmr_controller_og_create(struct wmr_controller_connection *conn,
 	u_var_add_f32(wcb, &ctrl->last_inputs.trigger, "input.trigger");
 	u_var_add_u8(wcb, &ctrl->last_inputs.battery, "input.battery");
 	u_var_add_bool(wcb, &ctrl->last_inputs.thumbstick.click, "input.thumbstick.click");
-	u_var_add_f32(wcb, &ctrl->last_inputs.thumbstick.values.x, "input.thumbstick.values.y");
-	u_var_add_f32(wcb, &ctrl->last_inputs.thumbstick.values.y, "input.thumbstick.values.x");
+	u_var_add_f32(wcb, &ctrl->last_inputs.thumbstick.values.x, "input.thumbstick.values.x");
+	u_var_add_f32(wcb, &ctrl->last_inputs.thumbstick.values.y, "input.thumbstick.values.y");
 	u_var_add_bool(wcb, &ctrl->last_inputs.trackpad.click, "input.trackpad.click");
 	u_var_add_bool(wcb, &ctrl->last_inputs.trackpad.touch, "input.trackpad.touch");
 	u_var_add_f32(wcb, &ctrl->last_inputs.trackpad.values.x, "input.trackpad.values.x");
