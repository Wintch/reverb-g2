From 1354ddf8bea2b166704252dd6124be981f2f4aa9 Mon Sep 17 00:00:00 2001
From: brunduk <nikolai.viktorovich@gmail.com>
Date: Mon, 12 Oct 2026 22:04:44 -0300
Subject: [PATCH] d/wmr: Make wmr_camera_stop() wait for the in-flight
 transfers

wmr_camera_stop() cancelled the image transfers and returned at once, but
cancellation is asynchronous: the USB thread could still be inside
img_xfer_cb() pushing a frame while the caller went on to tear down the
frame context, whose SLAM tracker node is broken apart and destroyed ahead
of the camera's. That is a SIGSEGV in the USB thread on session teardown.
c236c11f's early return covers callbacks that start after the stop, not
the one already past the check, which also resubmitted its transfer after
the cancel loop had found nothing to cancel.

Count the submitted transfers and wait, after cancelling, until each has
had its final completion; the callback decides between resubmit and retire
under the same lock that guards running. When stop() returns no callback
is executing and the transfers are idle, which wmr_camera_free() requires
before freeing them. The USB thread itself is untouched: it is started in
wmr_camera_open(), joined in wmr_camera_free(), and delivers the
completions this waits for.

On this series' base (735e29e4e) the two upstream commits this builds on
are missing, so they are folded in here: the early return in img_xfer_cb()
once the camera is stopped (c236c11fd, !2937) and setting cam->running in
wmr_camera_start() (8ed03a5cf, !3005), set under the new lock and before
the transfers are submitted. This replaces the former 0095 (a join of the
USB thread in stop(), which hung every camera teardown) and the former
0096 (cam->running set after the submit loop).

Signed-off-by: brunduk <nikolai.viktorovich@gmail.com>
---
 src/xrt/drivers/wmr/wmr_camera.c | 83 +++++++++++++++++++++++++++++++-
 1 file changed, 82 insertions(+), 1 deletion(-)

diff --git a/src/xrt/drivers/wmr/wmr_camera.c b/src/xrt/drivers/wmr/wmr_camera.c
index e8432060e..7c952b013 100644
--- a/src/xrt/drivers/wmr/wmr_camera.c
+++ b/src/xrt/drivers/wmr/wmr_camera.c
@@ -14,6 +14,7 @@
 #include "math/m_api.h"
 
 #include "os/os_threading.h"
+#include "os/os_time.h"
 #include "xrt/xrt_byte_order.h"
 
 #include "util/u_autoexpgain.h"
@@ -122,11 +123,20 @@ struct wmr_camera
 	libusb_context *ctx;
 	libusb_device_handle *dev;
 
+	//! Set by wmr_camera_start(), cleared by wmr_camera_stop(). Guarded by @ref xfer_lock.
 	bool running;
 
 	struct os_thread_helper usb_thread;
 	int usb_complete;
 
+	//! Guards @ref running and @ref xfers_in_flight.
+	struct os_mutex xfer_lock;
+	/*!
+	 * Image transfers submitted and not yet finally completed. wmr_camera_stop() waits for this to
+	 * reach zero so that no img_xfer_cb() is executing once it returns and the transfers can be freed.
+	 */
+	int xfers_in_flight;
+
 	struct wmr_camera_config tcam_confs[WMR_MAX_CAMERAS]; //!< Configs for tracking cameras
 	int tcam_count;                                       //!< Number of tracking cameras
 	int slam_cam_count;                                   //!< Number of tracking cameras used for SLAM
@@ -331,6 +341,18 @@ img_xfer_cb(struct libusb_transfer *xfer)
 
 	struct wmr_camera *cam = xfer->user_data;
 
+	// After a stop, the final completion of each transfer (normally LIBUSB_TRANSFER_CANCELLED) only retires it.
+	os_mutex_lock(&cam->xfer_lock);
+	bool running = cam->running;
+	if (!running) {
+		cam->xfers_in_flight--;
+	}
+	os_mutex_unlock(&cam->xfer_lock);
+
+	if (!running) {
+		return;
+	}
+
 	if (xfer->status != LIBUSB_TRANSFER_COMPLETED) {
 		WMR_CAM_DEBUG(cam, "Camera transfer completed with status: %s (%u)", libusb_error_name(xfer->status),
 		              xfer->status);
@@ -481,7 +503,20 @@ drop_frame:
 	xrt_frame_reference(&xf, NULL);
 
 out:
-	libusb_submit_transfer(xfer);
+	// Resubmit, unless wmr_camera_stop() ran while this frame was being processed: its cancel found
+	// nothing in flight to cancel, and a transfer resubmitted now, on a camera told to stop streaming,
+	// might never complete.
+	os_mutex_lock(&cam->xfer_lock);
+	if (!cam->running) {
+		cam->xfers_in_flight--;
+	} else {
+		int res = libusb_submit_transfer(xfer);
+		if (res < 0) {
+			WMR_CAM_ERROR(cam, "Failed to resubmit camera transfer: %s", libusb_error_name(res));
+			cam->xfers_in_flight--;
+		}
+	}
+	os_mutex_unlock(&cam->xfer_lock);
 }
 
 
@@ -510,6 +545,12 @@ wmr_camera_open(struct wmr_camera_open_config *config)
 		cam->ctrl_cam_sinks[i] = config->ctrl_cam_sinks != NULL ? config->ctrl_cam_sinks[i] : NULL;
 	}
 
+	if (os_mutex_init(&cam->xfer_lock) != 0) {
+		WMR_CAM_ERROR(cam, "Failed to initialise threading");
+		free(cam);
+		return NULL;
+	}
+
 	if (os_thread_helper_init(&cam->usb_thread) != 0) {
 		WMR_CAM_ERROR(cam, "Failed to initialise threading");
 		wmr_camera_free(cam);
@@ -681,6 +722,8 @@ wmr_camera_free(struct wmr_camera *cam)
 		cam->ctx = NULL;
 	}
 
+	os_mutex_destroy(&cam->xfer_lock);
+
 	// Tidy the variable tracking.
 	u_var_remove_root(cam);
 	u_sink_debug_destroy(&cam->debug_sinks[WMR_DEBUG_SINK_SLAM]);
@@ -716,6 +759,10 @@ wmr_camera_start(struct wmr_camera *cam)
 		goto fail;
 	}
 
+	os_mutex_lock(&cam->xfer_lock);
+	cam->running = true;
+	os_mutex_unlock(&cam->xfer_lock);
+
 	for (int i = 0; i < NUM_XFERS; i++) {
 		uint8_t *recv_buf = malloc(cam->xfer_size);
 
@@ -723,7 +770,15 @@ wmr_camera_start(struct wmr_camera *cam)
 		                          img_xfer_cb, cam, 0);
 		cam->xfers[i]->flags |= LIBUSB_TRANSFER_FREE_BUFFER;
 
+		// Counted before submitting: the completion may run on the USB thread before submit returns.
+		os_mutex_lock(&cam->xfer_lock);
+		cam->xfers_in_flight++;
 		res = libusb_submit_transfer(cam->xfers[i]);
+		if (res < 0) {
+			cam->xfers_in_flight--;
+		}
+		os_mutex_unlock(&cam->xfer_lock);
+
 		if (res < 0) {
 			WMR_CAM_ERROR(cam, "Failed to submit transfer %d", i);
 			goto fail;
@@ -753,17 +808,43 @@ wmr_camera_stop(struct wmr_camera *cam)
 	int res;
 	int i;
 
+	os_mutex_lock(&cam->xfer_lock);
 	if (!cam->running) {
+		os_mutex_unlock(&cam->xfer_lock);
 		return true;
 	}
 	cam->running = false;
+	os_mutex_unlock(&cam->xfer_lock);
 
+	// A transfer whose callback is executing right now is not in flight and is not found by the cancel;
+	// that callback sees running == false and retires the transfer instead of resubmitting it.
 	for (i = 0; i < NUM_XFERS; i++) {
 		if (cam->xfers[i] != NULL) {
 			libusb_cancel_transfer(cam->xfers[i]);
 		}
 	}
 
+	/*
+	 * Cancellation is asynchronous: wait until every transfer has had its final completion, i.e. until
+	 * the USB thread has run the last img_xfer_cb(). Before that, a callback could still be delivering a
+	 * frame into sinks that the caller goes on to tear down, and wmr_camera_free() could close the device
+	 * with transfers in flight. The USB thread keeps handling events until wmr_camera_free(). Bounded
+	 * like the equivalent wait in the UVC driver, so a misbehaving device cannot hang the teardown.
+	 */
+	int in_flight = 0;
+	for (int attempt = 0; attempt < 500; attempt++) {
+		os_mutex_lock(&cam->xfer_lock);
+		in_flight = cam->xfers_in_flight;
+		os_mutex_unlock(&cam->xfer_lock);
+		if (in_flight == 0) {
+			break;
+		}
+		os_nanosleep(OS_NS_PER_USEC * 1000);
+	}
+	if (in_flight != 0) {
+		WMR_CAM_WARN(cam, "%d camera transfers still in flight after 500 ms, stopping anyway", in_flight);
+	}
+
 	res = set_active(cam, false);
 	if (res < 0) {
 		goto fail;
-- 
2.47.3

