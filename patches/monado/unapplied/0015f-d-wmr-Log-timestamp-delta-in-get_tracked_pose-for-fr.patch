From 9f71a20c6453557fc9058e7e1f1f61418681457d Mon Sep 17 00:00:00 2001
From: brunduk <nikolai.viktorovich@gmail.com>
Date: Tue, 11 Aug 2026 02:40:00 -0300
Subject: [PATCH] d/wmr: Log timestamp delta in get_tracked_pose for
 freshness debugging

Samples are confirmed arriving continuously (constellation_sample_store
logs real, coherent positions), but get_tracked_pose was falling back
to the placeholder almost every time it was checked with a real
OpenXR client (hello_xr) attached. Logging at_timestamp_ns,
last_sample_ts, and their delta to find out whether this is a real
staleness (controller out of view) or a clock-domain mismatch between
the constellation tracker's blob-observation timestamps and Monado's
own prediction timestamps.
---
 src/xrt/drivers/wmr/wmr_controller_base.c | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/src/xrt/drivers/wmr/wmr_controller_base.c b/src/xrt/drivers/wmr/wmr_controller_base.c
index 7773cc6c9..e015ebc68 100644
--- a/src/xrt/drivers/wmr/wmr_controller_base.c
+++ b/src/xrt/drivers/wmr/wmr_controller_base.c
@@ -672,9 +672,14 @@ wmr_controller_base_get_tracked_pose(struct xrt_device *xdev,
 	static uint64_t get_tracked_pose_call_count = 0;
 	if (++get_tracked_pose_call_count % 90 == 0) {
 		bool pos_tracked = (out_relation->relation_flags & XRT_SPACE_RELATION_POSITION_TRACKED_BIT) != 0;
-		WMR_INFO(wcb, "get_tracked_pose: pos=(%.3f, %.3f, %.3f) position_tracked=%s",
+		WMR_INFO(wcb,
+		        "get_tracked_pose: pos=(%.3f, %.3f, %.3f) position_tracked=%s at_ts=%lld "
+		        "last_sample_ts=%lld delta_ms=%.1f sample_count=%llu",
 		        out_relation->pose.position.x, out_relation->pose.position.y,
-		        out_relation->pose.position.z, pos_tracked ? "yes" : "no (placeholder)");
+		        out_relation->pose.position.z, pos_tracked ? "yes" : "no (placeholder)",
+		        (long long)at_timestamp_ns, (long long)wcb->constellation.last_timestamp_ns,
+		        (double)(at_timestamp_ns - wcb->constellation.last_timestamp_ns) / 1e6,
+		        (unsigned long long)wcb->constellation.sample_count);
 	}
 
 	return XRT_SUCCESS;
-- 
2.47.3

