From cf993b813ed1deecd559310fb5e34e46e629e216 Mon Sep 17 00:00:00 2001
From: brunduk <nikolai.viktorovich@gmail.com>
Date: Tue, 4 Aug 2026 12:17:31 -0300
Subject: [PATCH 4/6] d/wmr: Retry controller firmware reads and shrink the
 failure window

On the tunnelled (headset-radio) transport, firmware commands share the
HID stream with the HMD IMU and both controllers' input packets, so a
single command frequently loses its reply to foreign traffic. One lost
reply failed the whole controller for the session.

- Wrap fw commands in a 3-attempt retry with backoff; the reads are
  offset-addressed (the request carries the remaining byte count), so
  resending is idempotent.
- Drop the unconditional 10ms per-chunk sleep to 1ms: it put a multi-kB
  config read at seconds per controller, which is exactly the window the
  transient errors landed in (read_sync already waits for the reply).
- Free the block buffer on the mid-read failure path (was leaked).

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 src/xrt/drivers/wmr/wmr_controller_base.c | 35 +++++++++++++++++++++--
 1 file changed, 32 insertions(+), 3 deletions(-)

diff --git a/src/xrt/drivers/wmr/wmr_controller_base.c b/src/xrt/drivers/wmr/wmr_controller_base.c
index a2ce7dc88..8eb60addb 100644
--- a/src/xrt/drivers/wmr/wmr_controller_base.c
+++ b/src/xrt/drivers/wmr/wmr_controller_base.c
@@ -162,6 +162,30 @@ wmr_controller_send_fw_cmd(struct wmr_controller_base *wcb,
 	return -ETIMEDOUT;
 }
 
+/* Firmware commands ride the same HID stream as the HMD IMU and both controllers' input
+ * packets on the tunnelled (headset-radio) transport, so a single command can easily lose
+ * its reply to foreign traffic. One lost reply used to fail the whole controller for the
+ * session; the reads are offset-addressed (the request carries the remaining byte count),
+ * so resending is idempotent and a short retry loop absorbs the transient losses. */
+static int
+wmr_controller_send_fw_cmd_retry(struct wmr_controller_base *wcb,
+                                 const struct wmr_controller_fw_cmd *fw_cmd,
+                                 unsigned char response_code,
+                                 struct wmr_controller_fw_cmd_response *response,
+                                 int attempts)
+{
+	int ret = -1;
+	for (int i = 0; i < attempts; i++) {
+		ret = wmr_controller_send_fw_cmd(wcb, fw_cmd, response_code, response);
+		if (ret >= 0) {
+			return ret;
+		}
+		WMR_DEBUG(wcb, "Controller fw cmd failed (%d), attempt %d of %d", ret, i + 1, attempts);
+		os_nanosleep(U_TIME_1MS_IN_NS * 20 * (i + 1));
+	}
+	return ret;
+}
+
 XRT_MAYBE_UNUSED static int
 wmr_read_fw_block(struct wmr_controller_base *d, uint8_t blk_id, uint8_t **out_data, size_t *out_size)
 {
@@ -177,7 +201,7 @@ wmr_read_fw_block(struct wmr_controller_base *d, uint8_t blk_id, uint8_t **out_d
 	memset(&fw_cmd, 0, sizeof(fw_cmd));
 
 	fw_cmd = WMR_CONTROLLER_FW_CMD_INIT(0x06, 0x02, blk_id, 0xffffffff);
-	if (wmr_controller_send_fw_cmd(d, &fw_cmd, 0x02, &fw_cmd_response) < 0) {
+	if (wmr_controller_send_fw_cmd_retry(d, &fw_cmd, 0x02, &fw_cmd_response, 3) < 0) {
 		WMR_WARN(d, "Failed to read fw - cmd 0x02 failed to read header for block %d", blk_id);
 		return -1;
 	}
@@ -206,9 +230,14 @@ wmr_read_fw_block(struct wmr_controller_base *d, uint8_t blk_id, uint8_t **out_d
 	while (remain > 0) {
 		fw_cmd = WMR_CONTROLLER_FW_CMD_INIT(0x06, 0x02, blk_id, remain);
 
-		os_nanosleep(U_TIME_1MS_IN_NS * 10); // Sleep 10ms
-		if (wmr_controller_send_fw_cmd(d, &fw_cmd, 0x02, &fw_cmd_response) < 0) {
+		/* Brief pacing between chunk requests. This used to be 10ms, which put a
+		 * multi-kB config read at seconds per controller - a needlessly wide window
+		 * for a transient transport error to land in (the read_sync timeout already
+		 * waits for the reply). */
+		os_nanosleep(U_TIME_1MS_IN_NS);
+		if (wmr_controller_send_fw_cmd_retry(d, &fw_cmd, 0x02, &fw_cmd_response, 3) < 0) {
 			WMR_WARN(d, "Failed to read fw - cmd 0x02 failed @ offset %zu", data_pos - data);
+			free(data);
 			return -1;
 		}
 
